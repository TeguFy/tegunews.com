{
  "name": "tegunews-cron",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Cron triggers — one minute granularity is the finest CF supports. Multiple
  // entries fire the same `scheduled` handler with different `event.cron`
  // values; switch on it inside the handler to route.
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tegunews",
      "database_id": "ba8b76be-8fbf-4716-a6b4-2e22f34f1d90"
    }
  ],
  // Workers AI — needed for the conversation-retry cron task that re-runs
  // failed generation attempts.
  "ai": { "binding": "AI" }
}
