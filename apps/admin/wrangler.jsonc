{
  "name": "tegunews-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tegunews",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tegunews-media",
      "preview_bucket_name": "tegunews-media-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_ID"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://admin.tegunews.com",
    "WEB_APP_URL": "https://tegunews.com"
  },
  "routes": [
    { "pattern": "admin.tegunews.com", "custom_domain": true }
  ]
}
